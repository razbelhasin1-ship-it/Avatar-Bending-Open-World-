; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Avatar: The Four Nations"
config/description="An open-world elemental bending action RPG (fan project)."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.039, 0.035, 0.035, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
Settings="*res://src/autoload/settings.gd"
GameState="*res://src/autoload/game_state.gd"
SaveSystem="*res://src/autoload/save_system.gd"
Audio="*res://src/autoload/audio_manager.gd"
WorldData="*res://src/autoload/world_data.gd"
Router="*res://src/autoload/router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="npc"
3d_physics/layer_5="companion"
3d_physics/layer_6="projectile"
3d_physics/layer_7="construct"
3d_physics/layer_8="water"
3d_physics/layer_9="interactable"
3d_physics/layer_10="trigger"
3d_physics/layer_11="wildlife"
3d_physics/layer_12="hurtbox"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.039, 0.035, 0.035, 1)
textures/default_filters/anisotropic_filtering_level=3
