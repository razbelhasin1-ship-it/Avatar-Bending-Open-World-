class_name SoundCatalog
extends RefCounted
## Static audio metadata: every sound name of the game, its category (voice
## limit + priority + bus), its distance size class and the region / weather /
## surface lookup tables used by the Audio autoload.
##
## Files live in res://assets/audio/sfx/<name>[_1.._6].wav|ogg and
## res://assets/audio/music/<track>.ogg (generated by tools/audiogen).

enum Size { SMALL, MEDIUM, LARGE, HUGE }

## Distance behaviour per size class (inverse-distance model).
## unit: distance (m) at which the sound plays at its nominal level.
## max: hard cut-off distance (level there is about -28 dB).
## cutoff/filter_db: air-absorption low-pass that deepens with distance.
const SIZE_PARAMS := {
	Size.SMALL: {"unit": 2.0, "max": 45.0, "cutoff": 7000.0, "filter_db": -18.0},
	Size.MEDIUM: {"unit": 4.5, "max": 95.0, "cutoff": 6000.0, "filter_db": -20.0},
	Size.LARGE: {"unit": 9.0, "max": 190.0, "cutoff": 4500.0, "filter_db": -22.0},
	Size.HUGE: {"unit": 18.0, "max": 380.0, "cutoff": 3500.0, "filter_db": -24.0},
}

## Category -> simultaneous voice limit, base priority (0..100, higher wins
## when voices are stolen), bus and default size class.
const CATEGORIES := {
	&"ui": {"limit": 6, "priority": 90, "bus": &"UI", "size": Size.SMALL},
	&"stinger": {"limit": 3, "priority": 95, "bus": &"SFX", "size": Size.SMALL},
	&"step": {"limit": 12, "priority": 10, "bus": &"SFX", "size": Size.SMALL},
	&"body": {"limit": 10, "priority": 35, "bus": &"SFX", "size": Size.SMALL},
	&"impact": {"limit": 10, "priority": 62, "bus": &"SFX", "size": Size.MEDIUM},
	&"bending": {"limit": 14, "priority": 55, "bus": &"SFX", "size": Size.MEDIUM},
	&"creature": {"limit": 6, "priority": 50, "bus": &"SFX", "size": Size.LARGE},
	&"loop": {"limit": 8, "priority": 80, "bus": &"SFX", "size": Size.MEDIUM},
	&"ambient": {"limit": 6, "priority": 20, "bus": &"Ambience", "size": Size.MEDIUM},
}

## Per-name priority overrides (critical combat feedback must never be dropped).
const PRIORITY := {
	&"parry": 88, &"block_impact": 72, &"hit_flesh": 66, &"punch_impact": 66, &"kick_impact": 66,
	&"fire_explosion": 75, &"earth_quake": 70, &"ice_shatter": 68, &"dragon_roar": 60, &"bison_call": 58,
}

## Per-name size overrides (default comes from the category).
const SIZES := {
	&"earth_quake": Size.HUGE, &"fire_explosion": Size.HUGE, &"dragon_roar": Size.HUGE, &"bison_call": Size.HUGE,
	&"gong": Size.HUGE, &"water_wave": Size.HUGE, &"air_tornado_loop": Size.HUGE,
	&"earth_crumble": Size.LARGE, &"earth_impact": Size.LARGE, &"earth_stomp": Size.LARGE, &"earth_wall_rise": Size.LARGE,
	&"earth_raise": Size.LARGE, &"earth_spikes": Size.LARGE, &"fire_blast": Size.LARGE, &"fire_ring": Size.LARGE,
	&"water_surge": Size.LARGE, &"air_sweep": Size.LARGE, &"ice_shatter": Size.LARGE, &"body_fall": Size.MEDIUM,
	&"land_heavy": Size.MEDIUM, &"step_heavy": Size.MEDIUM, &"creature_step_heavy": Size.LARGE,
	&"wing_flap_large": Size.LARGE, &"bison_groan": Size.LARGE, &"fire_loop": Size.LARGE,
	&"wind_chime": Size.SMALL, &"rock_debris": Size.MEDIUM,
}

const STINGERS: Array[StringName] = [&"pickup", &"quest_complete", &"discovery", &"level_up", &"gong", &"wind_chime"]

## Surfaces reported by WorldData.get_surface() / Events.footstep.
const SURFACES: Array[StringName] = [&"snow", &"ice", &"stone", &"grass", &"dirt", &"sand", &"wood", &"water", &"ash"]

const MUSIC_TRACKS: Array[StringName] = [&"music_menu", &"music_select", &"music_water_tribe", &"music_earth_kingdom",
	&"music_fire_nation", &"music_air_temple", &"music_combat", &"music_tutorial"]

## Region id (WorldData.get_region / Events.region_entered) -> exploration music.
## Regions without an entry keep whatever regional track is playing.
const REGION_MUSIC := {
	&"water_tribe": &"music_water_tribe",
	&"earth_kingdom": &"music_earth_kingdom",
	&"fire_nation": &"music_fire_nation",
	&"air_temple": &"music_air_temple",
}

## Region id -> default ambience bed (settlements may override with amb_city / amb_temple).
const REGION_AMBIENCE := {
	&"water_tribe": &"amb_arctic_wind",
	&"earth_kingdom": &"amb_forest",
	&"fire_nation": &"amb_volcanic",
	&"air_temple": &"amb_mountain_wind",
	&"wilds": &"amb_forest",
	&"ocean": &"amb_ocean_waves",
}

## Weather id (Events.weather_changed) -> weather ambience layer ("" = none).
const WEATHER_AMBIENCE := {
	&"rain": &"amb_rain", &"storm": &"amb_rain", &"thunderstorm": &"amb_rain", &"heavy_rain": &"amb_rain",
	&"blizzard": &"amb_blizzard", &"snowstorm": &"amb_blizzard",
}

## Regions where the night layer (crickets, frogs, owls) plays after dark.
const NIGHT_REGIONS: Array[StringName] = [&"earth_kingdom", &"wilds", &"fire_nation"]

## Every sound the game references (docs/ARCHITECTURE.md "Audio names").
const ALL_SFX: Array[StringName] = [
	&"ui_hover", &"ui_click", &"ui_back", &"ui_confirm", &"ui_open", &"ui_close", &"ui_error", &"ui_select_element",
	&"ui_notify", &"ui_quest", &"ui_levelup", &"ui_discovery",
	&"step_snow", &"step_ice", &"step_stone", &"step_grass", &"step_dirt", &"step_sand", &"step_wood",
	&"step_water", &"step_ash", &"step_heavy", &"land_soft", &"land_heavy", &"land_snow",
	&"whoosh_light", &"whoosh_heavy", &"punch_impact", &"kick_impact", &"body_fall", &"hit_flesh",
	&"block_impact", &"dodge_whoosh", &"jump", &"parry",
	&"air_blast", &"air_sweep", &"air_dash", &"air_shield_loop", &"air_jump", &"air_tornado_loop", &"air_push",
	&"air_impact",
	&"earth_raise", &"earth_launch", &"earth_impact", &"earth_wall_rise", &"earth_crumble", &"earth_stomp",
	&"earth_quake", &"earth_spikes", &"earth_armor", &"rock_debris",
	&"fire_ignite", &"fire_blast", &"fire_whoosh", &"fire_impact", &"fire_explosion", &"fire_loop",
	&"fire_charge_loop", &"fire_ring", &"fire_extinguish",
	&"water_whip", &"water_splash", &"water_blast", &"water_shield_loop", &"water_surge", &"water_draw",
	&"ice_form", &"ice_shatter", &"ice_impact", &"water_wave", &"water_heal_loop",
	&"bison_call", &"bison_groan", &"dragon_roar", &"wing_flap_large", &"dog_bark", &"dog_growl",
	&"badgermole_snort", &"badgermole_dig", &"creature_step_heavy",
	&"amb_arctic_wind", &"amb_blizzard", &"amb_city", &"amb_forest", &"amb_mountain_wind", &"amb_volcanic",
	&"amb_ocean_waves", &"amb_night", &"amb_rain", &"amb_temple",
	&"pickup", &"quest_complete", &"discovery", &"level_up", &"gong", &"wind_chime",
]

const _BENDING_PREFIXES := ["air_", "earth_", "fire_", "water_", "ice_", "rock_"]
const _CREATURE_PREFIXES := ["bison_", "dragon_", "dog_", "badgermole_", "wing_"]
const _IMPACT_PREFIXES := ["punch_", "kick_", "hit_", "block_", "body_"]


## Category of a sound name (see CATEGORIES).
static func category_of(sound_name: StringName) -> StringName:
	var s := String(sound_name)
	if s.begins_with("ui_"):
		return &"ui"
	if s.ends_with("_loop"):
		return &"loop"
	if s.begins_with("step_") or s.begins_with("land_") or s == "creature_step_heavy":
		return &"step"
	if s.begins_with("amb_") or s == "wind_chime" or s == "gong":
		return &"ambient"
	if STINGERS.has(sound_name):
		return &"stinger"
	if s == "parry":
		return &"impact"
	for p: String in _IMPACT_PREFIXES:
		if s.begins_with(p):
			return &"impact"
	for p: String in _BENDING_PREFIXES:
		if s.begins_with(p):
			return &"bending"
	for p: String in _CREATURE_PREFIXES:
		if s.begins_with(p):
			return &"creature"
	return &"body"


static func category_info(category: StringName) -> Dictionary:
	return CATEGORIES.get(category, CATEGORIES[&"body"])


static func priority_of(sound_name: StringName) -> int:
	if PRIORITY.has(sound_name):
		return PRIORITY[sound_name]
	return int(category_info(category_of(sound_name))["priority"])


static func size_of(sound_name: StringName) -> int:
	if SIZES.has(sound_name):
		return SIZES[sound_name]
	return int(category_info(category_of(sound_name))["size"])


static func size_params(size: int) -> Dictionary:
	return SIZE_PARAMS.get(size, SIZE_PARAMS[Size.MEDIUM])


## True for sounds that must loop (*_loop SFX, amb_* beds, music tracks).
static func is_loop(sound_name: StringName) -> bool:
	var s := String(sound_name)
	return s.ends_with("_loop") or s.begins_with("amb_") or s.begins_with("music_")


## Footstep sound for a surface (unknown surfaces fall back to dirt).
static func step_for_surface(surface: StringName) -> StringName:
	if SURFACES.has(surface):
		return StringName("step_" + String(surface))
	return &"step_dirt"
