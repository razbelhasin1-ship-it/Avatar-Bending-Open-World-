class_name EarthMarks
extends Node3D
## Persistent ground marks of earthbending (docs/modules/bending_earth.md
## "Environment"): cracked craters, long fissures and slide furrows that stay
## on the ground for a while (12-36 s by Settings detail level) and then fade.
## Projected Decals with a normal map on Forward+ / Mobile (the cracks read as
## real depressions under the sun); a flat ground quad on Compatibility.
## Tinted by the ground palette (EarthPalette) through Decal.modulate. Pooled
## and capped per kind (FxLib); on the Mobile renderer the caps stay low (it
## draws at most 8 decals per mesh).
##
##   EarthMarks.crater(self, ground_pos, 1.6, &"dirt")
##   EarthMarks.fissure(self, from_ground, to_ground, 0.9, &"stone")
##   EarthMarks.furrow(self, start_ground, dir, 3.0, &"sand")
## Textures: src/fx/earth/textures (generated by gen_earth_marks.py).

const TEX := {
	&"crater": [preload("res://src/fx/earth/textures/crater_albedo.png"), preload("res://src/fx/earth/textures/crater_normal.png")],
	&"fissure": [preload("res://src/fx/earth/textures/fissure_albedo.png"), preload("res://src/fx/earth/textures/fissure_normal.png")],
	&"furrow": [preload("res://src/fx/earth/textures/furrow_albedo.png"), preload("res://src/fx/earth/textures/furrow_normal.png")],
}
## Live marks per kind (before effects scaling) by Settings detail level 0..3.
const CAPS := {&"crater": [4, 6, 10, 14], &"fissure": [8, 12, 20, 28], &"furrow": [2, 3, 5, 6]}
## Seconds a mark stays (fades over the last 30 %) by detail level.
const LIFE := [12.0, 18.0, 26.0, 36.0]

var decal: Decal = null
var quad: MeshInstance3D = null
var quad_mat: StandardMaterial3D = null
var kind: StringName = &"crater"
var t := 0.0
var life := 20.0
var tint := Color(1, 1, 1)

static var _caps_set := -1


## A cracked crater: radial cracks, a crushed centre and a raised rim.
static func crater(from: Node, pos: Vector3, radius: float, surface: StringName = &"dirt", normal: Vector3 = Vector3.UP) -> EarthMarks:
	var m := _take(from, &"crater")
	var n := normal.normalized() if normal.length_squared() > 0.01 else Vector3.UP
	var x := n.cross(Vector3.FORWARD)
	if x.length_squared() < 0.01:
		x = Vector3.RIGHT
	x = x.normalized()
	var b := Basis(x, n, x.cross(n)).orthonormalized().rotated(n, randf() * TAU)
	# Shallow projection box (+-0.35 m): the cracks stay on the ground, not up the legs of whoever stands there.
	m._place(Transform3D(b, pos + n * 0.03), Vector3(radius * 2.0, 0.7, radius * 2.0), surface)
	return m


## A long jagged fissure from `a` to `b` (ground points), `width` m across.
static func fissure(from: Node, a: Vector3, b: Vector3, width: float, surface: StringName = &"dirt") -> EarthMarks:
	return fissure_like(from, &"fissure", a, b, width * 2.0, surface)


## Plough marks of a slide starting at `pos` along `dir` (heap at the end).
static func furrow(from: Node, pos: Vector3, dir: Vector3, length: float, surface: StringName = &"dirt", width: float = 0.9) -> EarthMarks:
	var d := Vector3(dir.x, 0.0, dir.z)
	d = d.normalized() if d.length_squared() > 1e-4 else Vector3.FORWARD
	return fissure_like(from, &"furrow", pos, pos + d * length, width, surface)


## A mark stretched from `a` to `b` (ground points): u along the line, `width` across.
## The projection box spans the height difference between the ends.
static func fissure_like(from: Node, p_kind: StringName, a: Vector3, b: Vector3, width: float, surface: StringName) -> EarthMarks:
	var m := _take(from, p_kind)
	var d := b - a
	d.y = 0.0
	var x := d.normalized() if d.length_squared() > 1e-4 else Vector3.RIGHT
	var basis := Basis(x, Vector3.UP, x.cross(Vector3.UP)).orthonormalized()
	m._place(Transform3D(basis, (a + b) * 0.5 + Vector3.UP * 0.03), Vector3(maxf(d.length(), 0.5), 1.0 + absf(a.y - b.y), width), surface)
	return m


static func lifetime() -> float:
	return LIFE[clampi(Settings.detail_level(), 0, 3)]


static func _take(from: Node, p_kind: StringName) -> EarthMarks:
	_ensure_caps()
	var pool := StringName("earth_mark_" + String(p_kind))
	var m := FxLib.take(from, pool, func() -> Node3D: return EarthMarks._make(p_kind)) as EarthMarks
	m.t = 0.0
	m.life = lifetime()
	return m


static func _ensure_caps() -> void:
	var lvl := clampi(Settings.detail_level(), 0, 3)
	if _caps_set == lvl:
		return
	_caps_set = lvl
	for k: StringName in CAPS:
		var c: int = CAPS[k][lvl]
		if Settings.is_mobile_renderer():
			c = mini(c, 6 if k == &"fissure" else 3)
		FxLib.set_cap(StringName("earth_mark_" + String(k)), c)


static func _make(p_kind: StringName) -> EarthMarks:
	var m := EarthMarks.new()
	m.kind = p_kind
	m.name = "EarthMark_%s" % p_kind
	var tex: Array = TEX[p_kind]
	if Settings.is_compatibility_renderer():
		m.quad = MeshInstance3D.new()
		var pm := PlaneMesh.new()
		pm.size = Vector2(1, 1)
		m.quad.mesh = pm
		m.quad_mat = StandardMaterial3D.new()
		m.quad_mat.albedo_texture = tex[0]
		m.quad_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.quad_mat.render_priority = -1
		m.quad.material_override = m.quad_mat
		m.quad.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		m.add_child(m.quad)
	else:
		m.decal = Decal.new()
		m.decal.texture_albedo = tex[0]
		m.decal.texture_normal = tex[1]
		m.decal.upper_fade = 0.3
		m.decal.lower_fade = 0.3
		m.decal.normal_fade = 0.25
		m.decal.cull_mask = 1
		m.add_child(m.decal)
	return m


func _place(xform: Transform3D, size: Vector3, surface: StringName) -> void:
	global_transform = xform
	var pal := EarthPalette.of(surface)
	# The texture is a luminance multiplier: tint it with the ground's rock colour
	# (a touch darker than the ground, so the marks read on light stone and dark soil).
	tint = (pal["rock"] as Color).lerp(pal["dark"] as Color, 0.25)
	if decal:
		decal.size = size
	elif quad:
		quad.scale = Vector3(size.x, 1.0, size.z)
	_set_alpha(1.0)
	FxLib.note(StringName("earth_mark_" + String(kind)))


func _set_alpha(a: float) -> void:
	if decal:
		decal.modulate = Color(tint.r, tint.g, tint.b, a)
	elif quad_mat:
		quad_mat.albedo_color = Color(tint.r, tint.g, tint.b, a)


func fx_reset() -> void:
	t = life


func _process(delta: float) -> void:
	t += delta
	var fade_start := life * 0.7
	if t > fade_start:
		_set_alpha(clampf(1.0 - (t - fade_start) / maxf(life - fade_start, 0.01), 0.0, 1.0))
	if t >= life:
		FxLib.release(self)
