extends Node
## World queries (autoload "WorldData").
##
## Single source of truth for terrain height, biomes, surfaces, regions, water, settlements
## and points of interest of the baked 8192 x 8192 m world (assets/world/, generated by
## tools/worldgen/generate_world.py). Gameplay code should use these queries instead of
## raycasting the terrain where possible: they also work where no terrain is streamed in.
##
## Loading is lazy: the first query (or load_world()) loads everything (~1 s, blocking);
## load_world_async() starts it on worker threads without blocking (e.g. from the main menu).
## When the data files are missing, or use_flat_world(true) is set, WorldData behaves like a
## flat grass plane at y = 0 (test arenas can also install `height_override`).
## Full reference: docs/modules/worlddata.md.

enum Biome { OCEAN, BEACH, SNOW, ICE, TUNDRA, GRASSLAND, FOREST, FARMLAND, ROCK, MOUNTAIN, VOLCANIC, ASH, TEMPLE, CITY }

const SEA_LEVEL := 0.0

## True once load_world() finished (with real data or the flat fallback).
var loaded: bool = false
## Optional override used by small test arenas: Callable(x, z) -> float. While valid it replaces
## the terrain height everywhere (biome/region queries fall back to the flat-world answers).
var height_override: Callable = Callable()
## Seconds the last load took (diagnostics).
var load_time_sec: float = 0.0
## Error from the last load attempt ("" when the real world data is active).
var load_error: String = ""

var data_dir: String = WorldConstants.DATA_DIR

var _height := WorldHeightfield.new()
var _maps := WorldMaps.new()
var _records := WorldRecords.new()
var _has_data := false
var _force_flat := false
var _group_task := -1
var _jobs: Array = []
var _load_t0 := 0
var _task_errors: Array[String] = []
var _task_mutex := Mutex.new()
var _load_mutex := Mutex.new()
var _map_texture: ImageTexture = null
var _sources: Array[Dictionary] = []


# --- Loading --------------------------------------------------------------------------------

## Loads world data (blocking). Safe and cheap to call repeatedly, from any thread.
func load_world() -> void:
	if loaded:
		return
	_load_mutex.lock()
	if not loaded:
		if _group_task < 0:
			_start_load()
		_finish_load()
	_load_mutex.unlock()


## Starts loading on worker threads and returns immediately. Events.world_ready fires when done.
func load_world_async() -> void:
	if loaded or _group_task >= 0:
		return
	_start_load()
	_poll_async.call_deferred()


func is_loaded() -> bool:
	return loaded


## True when the baked world is active (false = flat fallback).
func has_world_data() -> bool:
	_ensure()
	return _has_data and not _force_flat


## Forces the flat-plane fallback (true) or restores the baked world (false). For test arenas.
func use_flat_world(enabled: bool) -> void:
	_force_flat = enabled


func _start_load() -> void:
	_task_errors.clear()
	_has_data = false
	_load_t0 = Time.get_ticks_usec()
	_jobs = ["heightmap", "records"] + WorldMaps.map_names()
	_group_task = WorkerThreadPool.add_group_task(_load_job, _jobs.size(), -1, false, "WorldData load")


func _load_job(index: int) -> void:
	var job: String = _jobs[index]
	var err := ""
	match job:
		"heightmap":
			err = _height.load_file(data_dir.path_join(WorldConstants.HEIGHTMAP_FILE))
		"records":
			err = _records.load_file(data_dir.path_join(WorldConstants.JSON_FILE))
		_:
			err = _maps.load_map(job, data_dir)
	if not err.is_empty():
		_task_mutex.lock()
		_task_errors.append(err)
		_task_mutex.unlock()


func _poll_async() -> void:
	while _group_task >= 0 and not WorkerThreadPool.is_group_task_completed(_group_task):
		await get_tree().process_frame
	load_world()


func _finish_load() -> void:
	if _group_task >= 0:
		WorkerThreadPool.wait_for_group_task_completion(_group_task)
		_group_task = -1
	_has_data = _task_errors.is_empty() and _height.is_valid() and _maps.is_valid()
	load_error = "" if _has_data else "; ".join(_task_errors)
	if not _has_data:
		push_warning("WorldData: using the flat fallback world (%s)" % load_error)
	load_time_sec = (Time.get_ticks_usec() - _load_t0) / 1000000.0
	loaded = true
	if OS.get_thread_caller_id() == OS.get_main_thread_id():
		Events.world_ready.emit()
	else:
		Events.world_ready.emit.call_deferred()


func _ensure() -> void:
	if not loaded:
		load_world()


func _real() -> bool:
	if not loaded:
		load_world()
	return _has_data and not _force_flat


# --- Bounds, height, normal -------------------------------------------------------------------

## World bounds in meters (x/z min, size).
func get_bounds() -> Rect2:
	return Rect2(WorldConstants.WORLD_MIN, WorldConstants.WORLD_MIN, WorldConstants.WORLD_SIZE, WorldConstants.WORLD_SIZE)


## Terrain height at x/z (bilinear on the 2 m heightmap; exact formula in WorldHeightfield).
func get_height(x: float, z: float) -> float:
	if height_override.is_valid():
		return height_override.call(x, z)
	if not _real():
		return 0.0
	return _height.sample(x, z)


func get_normal(x: float, z: float) -> Vector3:
	var e := 0.5 if height_override.is_valid() or not _real() else WorldConstants.TEXEL_SIZE
	var hx := get_height(x + e, z) - get_height(x - e, z)
	var hz := get_height(x, z + e) - get_height(x, z - e)
	return Vector3(-hx, 2.0 * e, -hz).normalized()


## Terrain slope in degrees.
func get_slope_deg(x: float, z: float) -> float:
	return rad_to_deg(get_normal(x, z).angle_to(Vector3.UP))


## Heights on a regular grid for collision patches: row-major PackedFloat32Array of
## count_x * count_z samples, value[j * count_x + i] = get_height(origin_x + i*step, origin_z + j*step).
## Pass it straight to HeightMapShape3D.map_data (map_width = count_x, map_depth = count_z,
## CollisionShape3D scaled by `step` and centred on the block).
func get_height_block(origin_x: float, origin_z: float, count_x: int, count_z: int, step: float) -> PackedFloat32Array:
	if height_override.is_valid() or not _real():
		var out := PackedFloat32Array()
		out.resize(maxi(count_x, 0) * maxi(count_z, 0))
		var k := 0
		for j in count_z:
			for i in count_x:
				out[k] = get_height(origin_x + i * step, origin_z + j * step)
				k += 1
		return out
	return _height.block(origin_x, origin_z, count_x, count_z, step)


## Fills a HeightMapShape3D with heightmap texels [texel_x, texel_x + width) x [texel_z, texel_z + depth)
## using the native image path (fast). The shape's local origin is the centre of that block;
## place its CollisionShape3D at WorldData.texel_block_center(...). Returns false without data.
func fill_height_map_shape(shape: HeightMapShape3D, texel_x: int, texel_z: int, width: int, depth: int) -> bool:
	if not _real() or height_override.is_valid():
		return false
	var img := _height.collision_image(texel_x, texel_z, width, depth)
	if img == null:
		return false
	shape.map_width = img.get_width()
	shape.map_depth = img.get_height()
	shape.update_map_data_from_image(img, WorldConstants.HEIGHT_MIN, WorldConstants.HEIGHT_MAX)
	return true


## World x/z centre of a texel block (where a HeightMapShape3D filled by fill_height_map_shape goes).
func texel_block_center(texel_x: int, texel_z: int, width: int, depth: int) -> Vector2:
	var t := WorldConstants.TEXEL_SIZE
	return Vector2(WorldConstants.WORLD_MIN + (texel_x + (width - 1) * 0.5 + 0.5) * t,
			WorldConstants.WORLD_MIN + (texel_z + (depth - 1) * 0.5 + 0.5) * t)


## Marches a ray against the terrain heightfield (no physics needed). Returns
## {"hit": bool, "position": Vector3, "distance": float}.
func raycast_terrain(origin: Vector3, direction: Vector3, max_distance: float = 2000.0) -> Dictionary:
	var dir := direction.normalized()
	var step := 4.0
	var prev_t := 0.0
	var prev_above := origin.y - get_height(origin.x, origin.z)
	if prev_above < 0.0:
		return {"hit": true, "position": Vector3(origin.x, get_height(origin.x, origin.z), origin.z), "distance": 0.0}
	var t := step
	while t <= max_distance:
		var p := origin + dir * t
		var above := p.y - get_height(p.x, p.z)
		if above <= 0.0:
			var lo := prev_t
			var hi := t
			for k in 18:
				var mid := (lo + hi) * 0.5
				var q := origin + dir * mid
				if q.y - get_height(q.x, q.z) > 0.0:
					lo = mid
				else:
					hi = mid
			var hp := origin + dir * hi
			return {"hit": true, "position": Vector3(hp.x, get_height(hp.x, hp.z), hp.z), "distance": hi}
		prev_t = t
		step = clampf(above * 0.5, 1.0, 32.0)
		t += step
	return {"hit": false, "position": origin + dir * max_distance, "distance": max_distance}


# --- Biomes, surfaces, regions ------------------------------------------------------------------

func get_biome(x: float, z: float) -> int:
	if height_override.is_valid() or not _real():
		return Biome.GRASSLAND
	return _maps.biome_at(x, z)


## Surface material for footsteps/VFX: &"snow", &"ice", &"stone", &"grass",
## &"dirt", &"sand", &"wood", &"water", &"ash".
func get_surface(pos: Vector3) -> StringName:
	if height_override.is_valid() or not _real():
		return _biome_surface(Biome.GRASSLAND)
	var wh := get_water_height(pos.x, pos.z)
	if wh > -INF and pos.y < wh + 0.15:
		return &"water"
	var b := _maps.biome_at(pos.x, pos.z)
	if _maps.road_at(pos.x, pos.z) > 0.5 and b != Biome.CITY:
		return &"stone" if _maps.ground_at(pos.x, pos.z).r > 0.5 else &"dirt"
	var s := _maps.splat_at(pos.x, pos.z)
	match b:
		Biome.ICE:
			return &"ice"
		Biome.MOUNTAIN, Biome.ROCK, Biome.TUNDRA:
			if s.r > 0.55:
				return &"snow"
	if b != Biome.SNOW and b != Biome.CITY and b != Biome.TEMPLE and s.g > 0.65:
		return &"stone"
	return _biome_surface(b)


func _biome_surface(b: int) -> StringName:
	match b:
		Biome.SNOW, Biome.TUNDRA: return &"snow"
		Biome.ICE: return &"ice"
		Biome.BEACH: return &"sand"
		Biome.ROCK, Biome.MOUNTAIN, Biome.TEMPLE, Biome.CITY: return &"stone"
		Biome.VOLCANIC, Biome.ASH: return &"ash"
		Biome.FARMLAND: return &"dirt"
		Biome.OCEAN: return &"water"
	return &"grass"


## Depth of loose snow at a point in meters (0 if none).
func get_snow_depth(x: float, z: float) -> float:
	var b := get_biome(x, z)
	if height_override.is_valid() or not _real():
		return 0.35 if b == Biome.SNOW else (0.15 if b == Biome.TUNDRA else 0.0)
	var s := _maps.splat_at(x, z).r
	match b:
		Biome.SNOW:
			var deep := clampf((get_height(x, z) - 150.0) / 500.0, 0.0, 1.0)
			return (0.28 + 0.27 * deep) * clampf(s * 1.15, 0.35, 1.0)
		Biome.TUNDRA:
			return 0.16 * s
		Biome.ICE:
			return 0.04
		Biome.CITY:
			return 0.08 if s > 0.3 or get_region(x, z) == &"water_tribe" else 0.0
		Biome.MOUNTAIN, Biome.ROCK:
			return 0.25 * s
	return 0.0


## Splat weights at a point: Color(snow, rock, lush, sand_ash) (all 0..1).
func get_splat(x: float, z: float) -> Color:
	if height_override.is_valid() or not _real():
		return Color(0, 0, 0.6, 0)
	return _maps.splat_at(x, z)


## Road coverage 0..1 (1 = on a road surface).
func get_road(x: float, z: float) -> float:
	if height_override.is_valid() or not _real():
		return 0.0
	return _maps.road_at(x, z)


## Ground hints: Color(paved_road, settlement_paving, farmland, wetness).
func get_ground_hints(x: float, z: float) -> Color:
	if height_override.is_valid() or not _real():
		return Color(0, 0, 0, 0)
	return _maps.ground_at(x, z)


## Region id: &"water_tribe", &"earth_kingdom", &"fire_nation", &"air_temple",
## &"wilds" (between nations) or &"ocean".
func get_region(x: float, z: float) -> StringName:
	if height_override.is_valid() or not _real():
		return &"wilds"
	var i := _maps.region_index_at(x, z)
	return WorldConstants.REGION_IDS[i] if i < WorldConstants.REGION_IDS.size() else &"wilds"


func get_region_name(region_id: StringName) -> String:
	match region_id:
		&"water_tribe": return "Northern Water Tribe"
		&"earth_kingdom": return "Earth Kingdom"
		&"fire_nation": return "Fire Nation"
		&"air_temple": return "Southern Air Temple"
		&"ocean": return "Open Sea"
	return "The Wilds"


# --- Water ---------------------------------------------------------------------------------------

## Water surface height at x/z, or -INF if there is no water there (sea, lakes, canals, pools).
## Frozen lakes are solid ice (no water).
func get_water_height(x: float, z: float) -> float:
	if height_override.is_valid() or not _real():
		return SEA_LEVEL if get_height(x, z) < SEA_LEVEL else -INF
	var ground := _height.sample(x, z)
	var p := Vector2(x, z)
	for entry: Dictionary in _records.water_candidates(x, z):
		if entry["kind"] == &"canal":
			var c := _records.canals[entry["index"]]
			if ground < float(c["level"]) and WorldRecords.polyline_closest(p, c["points"])["distance"] <= float(c["width"]) * 0.5 + 0.5:
				return float(c["level"])
		else:
			var lk := _records.lakes[entry["index"]]
			if lk["frozen"]:
				continue
			var cc: Vector3 = lk["center"]
			if ground < float(lk["level"]) and Vector2(cc.x, cc.z).distance_to(p) <= float(lk["radius"]):
				return float(lk["level"])
	if ground < SEA_LEVEL:
		return SEA_LEVEL
	return -INF


func is_underwater(pos: Vector3) -> bool:
	return pos.y < get_water_height(pos.x, pos.z)


## Nearest bendable water source within `radius`.
## Returns {"found": bool, "position": Vector3, "kind": &"water"|&"snow"|&"ice"|&"source", "distance": float}.
## Snow/ice biomes count as sources everywhere; sea/lakes/canals/pools/fountains count
## within range. Registered sources (fountains, canals) are included.
func find_water_source(pos: Vector3, radius: float) -> Dictionary:
	var best := {"found": false, "position": pos, "kind": &"", "distance": INF}
	for s: Dictionary in _sources:
		var d := (s["position"] as Vector3).distance_to(pos)
		if d <= radius + float(s.get("radius", 0.0)) and d < best["distance"]:
			best = {"found": true, "position": s["position"], "kind": s.get("kind", &"source"), "distance": d}
	if best["found"]:
		return best
	if not height_override.is_valid() and _real():
		best = _nearest_world_water(pos, radius)
		if best["found"]:
			return best
	var surf := get_surface(pos)
	if surf == &"snow" or surf == &"ice":
		return {"found": true, "position": Vector3(pos.x, get_height(pos.x, pos.z), pos.z), "kind": surf, "distance": 0.0}
	if height_override.is_valid() or not _real():
		var wh := get_water_height(pos.x, pos.z)
		if wh > -INF:
			return {"found": true, "position": Vector3(pos.x, wh, pos.z), "kind": &"water", "distance": 0.0}
	return {"found": false, "position": pos, "kind": &"", "distance": INF}


func _nearest_world_water(pos: Vector3, radius: float) -> Dictionary:
	var best := {"found": false, "position": pos, "kind": &"", "distance": INF}
	var p2 := Vector2(pos.x, pos.z)
	var here := get_water_height(pos.x, pos.z)
	if here > -INF:
		return {"found": true, "position": Vector3(pos.x, here, pos.z), "kind": &"water", "distance": maxf(pos.y - here, 0.0)}
	for c in _records.canals:
		var r := WorldRecords.polyline_closest(p2, c["points"])
		var d := Vector3(r["point"].x, float(c["level"]), r["point"].y).distance_to(pos)
		if d <= radius + float(c["width"]) * 0.5 and d < best["distance"]:
			best = {"found": true, "position": Vector3(r["point"].x, float(c["level"]), r["point"].y), "kind": &"water", "distance": d}
	for lk in _records.lakes:
		var cc: Vector3 = lk["center"]
		if Vector2(cc.x, cc.z).distance_to(p2) > radius + float(lk["radius"]):
			continue
		var poly: PackedVector2Array = lk["polygon"]
		var closed := poly.duplicate()
		closed.append(poly[0])
		var r := WorldRecords.polyline_closest(p2, closed)
		var q: Vector2 = r["point"]
		if Geometry2D.is_point_in_polygon(p2, poly):
			q = p2
		var target := Vector3(q.x, float(lk["level"]), q.y)
		var d := target.distance_to(pos)
		if d <= radius and d < best["distance"]:
			best = {"found": true, "position": target, "kind": &"ice" if lk["frozen"] else &"water", "distance": d}
	# open sea: scan rings around the point
	var rings := 6
	for ring in range(1, rings + 1):
		var rr := radius * float(ring) / float(rings)
		if rr > best["distance"]:
			break
		var steps := 8 + ring * 4
		for k in steps:
			var a := TAU * float(k) / float(steps)
			var x := pos.x + sin(a) * rr
			var z := pos.z + cos(a) * rr
			if _height.sample(x, z) < SEA_LEVEL - 0.3:
				var target := Vector3(x, SEA_LEVEL, z)
				var d := target.distance_to(pos)
				if d <= radius and d < best["distance"]:
					best = {"found": true, "position": target, "kind": &"water", "distance": d}
	return best


## Registers a bendable water source (fountain, canal, pond). Returns an id.
func register_water_source(position: Vector3, radius: float, kind: StringName = &"water") -> int:
	_sources.append({"position": position, "radius": radius, "kind": kind, "id": _sources.size()})
	return _sources.size() - 1


func clear_water_sources() -> void:
	_sources.clear()


# --- Points of interest ------------------------------------------------------------------------

## Points of interest: Array of {"id", "name", "type", "region", "position": Vector3, "radius",
## "description"} (+ "yaw", "underground", "tunnel": PackedVector3Array for caves).
func get_pois() -> Array[Dictionary]:
	if not _real():
		return []
	return _records.pois


func get_poi(poi_id: StringName) -> Dictionary:
	if not _real():
		return {}
	return _records.get_poi(poi_id)


## Nearest POI to `pos` (optionally of one `type`) within max_distance, or {}.
func get_nearest_poi(pos: Vector3, type: StringName = &"", max_distance: float = INF) -> Dictionary:
	var best := {}
	var best_d := max_distance
	for p in get_pois():
		if type != &"" and p["type"] != type:
			continue
		var d := (p["position"] as Vector3).distance_to(pos)
		if d <= best_d:
			best_d = d
			best = p
	return best


## POIs whose position lies within `radius` of pos (closest first), optionally of one type.
func get_pois_in_radius(pos: Vector3, radius: float, type: StringName = &"") -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for p in get_pois():
		if (type == &"" or p["type"] == type) and (p["position"] as Vector3).distance_to(pos) <= radius:
			out.append(p)
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return (a["position"] as Vector3).distance_squared_to(pos) < (b["position"] as Vector3).distance_squared_to(pos))
	return out


## POIs of one region (&"water_tribe", ...).
func get_pois_in_region(region_id: StringName) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for p in get_pois():
		if p["region"] == region_id:
			out.append(p)
	return out


