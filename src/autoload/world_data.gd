# --- Spawns and cameras -------------------------------------------------------------------------

## Spawn transform for a new game of the given element (home region). Basis faces the view
## (-Z forward); origin is on the ground.
func get_spawn(element: int) -> Transform3D:
	if _real():
		var s: Dictionary = _records.spawns.get(String(ElementDefs.id_of(element)), {})
		if not s.is_empty():
			return Transform3D(Basis(Vector3.UP, float(s["yaw"])), s["position"])
	return Transform3D(Basis.IDENTITY, Vector3(0, get_height(0, 0) + 1.0, 0))


## Arrival flyover for an element: {"start": Transform3D, "end": Transform3D, "duration": float,
## "fov_start": float, "fov_end": float}. Cameras look down their -Z axis. Empty without data.
func get_arrival_camera(element: int) -> Dictionary:
	if not _real():
		return {}
	var c: Dictionary = _records.cameras.get(String(ElementDefs.id_of(element)), {})
	if c.is_empty():
		return {}
	return {
		"start": _look_transform(c["start"]["position"], c["start"]["look_at"]),
		"end": _look_transform(c["end"]["position"], c["end"]["look_at"]),
		"duration": float(c.get("duration", 8.0)),
		"fov_start": float(c.get("fov_start", 60.0)),
		"fov_end": float(c.get("fov_end", 72.0)),
	}


static func _look_transform(from: Vector3, to: Vector3) -> Transform3D:
	return Transform3D(Basis.IDENTITY, from).looking_at(to, Vector3.UP)


## Safe ground position near `pos` (above terrain, not in water, walkable slope). Used for
## respawning and unsticking companions.
func get_safe_ground(pos: Vector3) -> Vector3:
	if height_override.is_valid() or not _real():
		return Vector3(pos.x, get_height(pos.x, pos.z) + 0.2, pos.z)
	if _is_safe(pos.x, pos.z):
		return Vector3(pos.x, get_height(pos.x, pos.z) + 0.2, pos.z)
	for ring in range(1, 33):
		var rr := ring * 8.0
		var steps := 8 + ring * 2
		for k in steps:
			var a := TAU * float(k) / float(steps)
			var x := pos.x + sin(a) * rr
			var z := pos.z + cos(a) * rr
			if _is_safe(x, z):
				return Vector3(x, get_height(x, z) + 0.2, z)
	var best := Vector3.INF
	for p in get_ports():
		var q: Vector3 = p["quay"]
		if best == Vector3.INF or q.distance_squared_to(pos) < best.distance_squared_to(pos):
			best = q
	return best + Vector3(0, 0.2, 0) if best != Vector3.INF else Vector3(pos.x, get_height(pos.x, pos.z) + 0.2, pos.z)


func _is_safe(x: float, z: float) -> bool:
	var h := get_height(x, z)
	return get_water_height(x, z) < h - 0.3 and get_slope_deg(x, z) < 32.0


# --- Textures for renderers and UI -------------------------------------------------------------

## Raw heightmap texture (FORMAT_RG8: R = low byte, G = high byte of the uint16 height code).
## Sample only with world_height.gdshaderinc (texelFetch). Null without data.
func get_height_texture() -> Texture2D:
	return _height.texture() if _real() else null


## Filtered, mipmapped height texture (FORMAT_RF, normalised 0..1 over HEIGHT_MIN..HEIGHT_MAX).
func get_height_lod_texture(size: int = 1024) -> Texture2D:
	return _height.lod_texture(size) if _real() else null


## The full-resolution heightmap as a FORMAT_R16 Image (shared memory: treat as read-only).
func get_height_image() -> Image:
	return _height.image_r16() if _real() else null


## Splat weights texture (RGBA: snow, rock, lush, sand/ash), mipmapped.
func get_splat_texture() -> Texture2D:
	return _maps.texture("splat") if _real() else null


## Biome id texture (FORMAT_L8; value = Biome). Read with texelFetch: id = round(r * 255).
func get_biome_texture() -> Texture2D:
	return _maps.texture("biome") if _real() else null


func get_region_texture() -> Texture2D:
	return _maps.texture("region") if _real() else null


## Road coverage texture (FORMAT_L8 at 2 m), mipmapped.
func get_road_texture() -> Texture2D:
	return _maps.texture("roads") if _real() else null


## Ground hint texture (RGBA: paved road, settlement paving, farmland, wetness), mipmapped.
func get_ground_texture() -> Texture2D:
	return _maps.texture("ground") if _real() else null


## Sets the heightmap uniforms used by world_height.gdshaderinc on a material.
func apply_height_uniforms(material: ShaderMaterial) -> void:
	if material and _real():
		material.set_shader_parameter(&"world_height_map", get_height_texture())


## Painterly parchment world map for the map screen (no baked text), mipmapped. Loaded lazily.
func get_map_texture() -> Texture2D:
	if _map_texture == null:
		var path := data_dir.path_join(WorldConstants.MAP_FILE)
		if FileAccess.file_exists(path):
			var img := Image.new()
			if img.load_jpg_from_buffer(FileAccess.get_file_as_bytes(path)) == OK:
				img.generate_mipmaps()
				_map_texture = ImageTexture.create_from_image(img)
	return _map_texture


## UV (0..1) of a world position on the map image / any world-covering texture.
func world_to_map_uv(pos: Vector3) -> Vector2:
	return Vector2((pos.x - WorldConstants.WORLD_MIN) / WorldConstants.WORLD_SIZE,
			(pos.z - WorldConstants.WORLD_MIN) / WorldConstants.WORLD_SIZE)


## Inverse of world_to_map_uv (y = terrain height).
func map_uv_to_world(uv: Vector2) -> Vector3:
	var x := WorldConstants.WORLD_MIN + uv.x * WorldConstants.WORLD_SIZE
	var z := WorldConstants.WORLD_MIN + uv.y * WorldConstants.WORLD_SIZE
	return Vector3(x, get_height(x, z), z)


## Raw parsed metadata (version, seed, heightmap/map descriptors, regions).
func get_meta_info() -> Dictionary:
	return _records.meta if _real() else {}
